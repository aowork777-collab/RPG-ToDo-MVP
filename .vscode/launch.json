{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RPG ToDoを起動",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "RPG ToDo ready at (http://localhost:[0-9]+/)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
